+# GhostLock final config for Infinix Smart 20 (X6840)
+# Kernel: 6.6.118-android15-8-g0b9c3bf6db7f-ab14877662-4k
+# Import this through GhostLock -> Advanced -> Parameter configuration ->
+# Load configuration -> Import offsets.conf (v2). Then load it.
+# This profile does NOT recommend Shizuku: the app runs the exploit in its
+# own process and W3 clears seccomp there. W3 parks the rooted child, zeroes
+# thread_info.flags and seccomp.mode (the only value the write primitive can
+# land is zero), resumes it and verifies "Seccomp: 0". No ADB, no Shizuku.
+# A shell flow (Shizuku or adb shell) still works: it has no app filter, so
+# W3 skips itself.
+release = "6.6.118-android15-8-g0b9c3bf6db7f-ab14877662-4k"
+schema_version = 1
+kernel_major = 6
+recommend_shizuku = 0
+kernel_phys_load = 1074266112
+kernel_phys_offset = 1073741824
+route {
+  select_stack {
+    waiter_shift = -2
+  }
+}
+fallback {
+  to = "none"
+}
+execution {
+  selected_cpus {
+    main = 6
+    consumer = 7
+  }
+  stages {
+    w3_chain_rounds = 2
+    w3_attempts = 2
+    w3_settle_us = 50000
+  }
+}
+kernelsnitch {
+  collisions = 4
+  mm_struct_sz = null
+}
+task_struct {
+  prio = 132
+  normal_prio = 140
+  sched_task_group = 840
